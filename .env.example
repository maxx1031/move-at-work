# Copy to .env (gitignored) and fill in. Never commit the real .env.
# fal.ai API key for the Seedance backend (fal.ai dashboard > Keys)
FAL_KEY=
# Optional: which Seedance endpoint ("2.5-us" default, "2.5", "2.0-fast", or a full fal endpoint id)
# SEEDANCE_ENDPOINT=2.0-fast
# Local ExRx SurrealDB (exrx_db/). Root account for serve.sh/load.py; read-only account for query tools.
EXRX_DB_USER=root
EXRX_DB_PASS=
EXRX_READER_PASS=
